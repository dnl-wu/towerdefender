{
  "name": "towerdefender",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types 'tests/**/*.test.ts'",
    "balance": "node --experimental-strip-types scripts/balance.ts",
    "demo": "node --experimental-strip-types scripts/demo.ts",
    "standalone": "node --experimental-strip-types scripts/standalone.ts",
    "account": "node --experimental-strip-types scripts/account.ts",
    "solo": "node --experimental-strip-types scripts/solo.ts",
    "goblins": "node --experimental-strip-types scripts/goblins.ts",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@opennextjs/cloudflare": "^1.20.18",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "wrangler": "^4.168.0"
  }
}