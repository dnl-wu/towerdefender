{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": "worker.js",
	"durable_objects": { "bindings": [{ "name": "ARENA", "class_name": "TowerArena" }] },
	"migrations": [{ "tag": "arena-v1", "new_sqlite_classes": ["TowerArena"] }],
	"name": "towerdefender",
	"compatibility_date": "2026-11-25",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "towerdefender"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	}
}